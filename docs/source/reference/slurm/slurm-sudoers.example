# Example for SSH account skypilot submitting as alice. Requires sudo >= 1.9.10.
# Adjust executable locations, account names, and the shared base directory.
Defaults:skypilot secure_path=/opt/slurm/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Defaults>alice !requiretty
skypilot ALL=(alice) NOPASSWD: /usr/bin/sbatch, /usr/bin/srun, /usr/bin/scancel, /usr/bin/squeue
skypilot ALL=(alice) NOPASSWD: /usr/bin/scontrol ^-o show step [0-9]+$
skypilot ALL=(alice) NOPASSWD: /usr/bin/id ^-un$
skypilot ALL=(alice) NOPASSWD: /usr/bin/stat ^-f -c %T -- /home/alice$
skypilot ALL=(alice) NOPASSWD: /usr/bin/mkdir ^(-p )?-- /home/alice/[.]sky_(provision|clusters|snapshots)(/([.][A-Za-z_]|[A-Za-z0-9_])[A-Za-z0-9_.-]*)*$
skypilot ALL=(alice) NOPASSWD: /usr/bin/test ^(! )?-(e|f) /home/alice/[.]sky_(provision|clusters|snapshots)(/([.][A-Za-z_]|[A-Za-z0-9_])[A-Za-z0-9_.-]*)*$
skypilot ALL=(alice) NOPASSWD: /usr/bin/cat ^-- /home/alice/[.]sky_(provision|clusters|snapshots)(/([.][A-Za-z_]|[A-Za-z0-9_])[A-Za-z0-9_.-]*)*$
skypilot ALL=(alice) NOPASSWD: /usr/bin/tail ^-n [0-9]+ (-f )?-- /home/alice/[.]sky_provision/slurm-[0-9]+[.]out$
skypilot ALL=(alice) NOPASSWD: /usr/bin/mv ^(-f )?-- /home/alice/[.]sky_(provision|clusters|snapshots)(/([.][A-Za-z_]|[A-Za-z0-9_])[A-Za-z0-9_.-]*)* /home/alice/[.]sky_(provision|clusters|snapshots)(/([.][A-Za-z_]|[A-Za-z0-9_])[A-Za-z0-9_.-]*)*$
skypilot ALL=(alice) NOPASSWD: /usr/bin/rm ^-rf -- /home/alice/[.]sky_(provision|clusters|snapshots)(/([.][A-Za-z_]|[A-Za-z0-9_])[A-Za-z0-9_.-]*)*$
skypilot ALL=(alice) NOPASSWD: /usr/bin/find ^/home/alice/[.]sky_clusters/[A-Za-z0-9_-]+ -depth -mindepth 1 ! -path /home/alice/[.]sky_clusters/[A-Za-z0-9_-]+/sky_logs ! -path /home/alice/[.]sky_clusters/[A-Za-z0-9_-]+/sky_logs/[*] -delete$
skypilot ALL=(alice) NOPASSWD: /usr/bin/find ^/home/alice/[.]sky_clusters/[A-Za-z0-9_-]+ -mindepth 1 -maxdepth 1 ! -name sky_logs -print -quit$
skypilot ALL=(alice) NOPASSWD: /usr/bin/rsync ^--server (--sender )?-vlDtprze[.]iLsfxCIvu? (--partial )?[.] /home/alice/[.]sky_(provision|clusters|snapshots)(/([.][A-Za-z_]|[A-Za-z0-9_])[A-Za-z0-9_.-]*)*$
