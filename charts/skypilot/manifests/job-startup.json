        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "A stale or missing snapshot makes the other panels show no data. Zero waiting is only shown with a fresh snapshot.",
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(sky_managed_job_wait_snapshot_timestamp_seconds)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
