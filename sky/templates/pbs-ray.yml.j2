cluster_name: {{cluster_name_on_cloud}}

# The maximum number of workers nodes to launch in addition to the head node.
max_workers: {{num_nodes - 1}}
upscaling_speed: {{num_nodes - 1}}
idle_timeout_minutes: 60

provider:
  type: external
  module: sky.provision.pbs

  cluster: "{{pbs_cluster}}"
  queue: "{{pbs_queue}}"
  provision_timeout: {{provision_timeout}}
  sky_base_dir: {{sky_base_dir | tojson}}
{% if pbs_tmpdir is not none %}
  # Node-local base of the SkyPilot runtime directory, expanded on the node.
  tmpdir: {{pbs_tmpdir | tojson}}
{% endif %}
  # Authorized on the user-level sshd the allocation runs on every node;
  # the token is replaced with SkyPilot's public key when the config is
  # written (sky/authentication.py::configure_ssh_info).
  ssh_public_key_content: "skypilot:ssh_public_key_content"

  ssh:
    hostname: {{ssh_hostname}}
    port: {{ssh_port}}
    user: {{ssh_user}}
{% if pbs_private_key is not none %}
    private_key: {{pbs_private_key}}
{% endif %}
{% if pbs_proxy_command is not none %}
    proxycommand: {{pbs_proxy_command | tojson }}
{% endif %}
{% if pbs_proxy_jump is not none %}
    proxyjump: {{pbs_proxy_jump | tojson }}
{% endif %}
    identities_only: {{pbs_identities_only}}
{% if pbs_control_path is not none %}
    control_path: {{pbs_control_path | tojson}}
{% endif %}

auth:
  ssh_user: {{ssh_user}}
  ssh_private_key: {{ssh_private_key}}

available_node_types:
  ray_head_default:
    resources: {}
    node_config:
      # From clouds/pbs.py::PBS.make_deploy_resources_variables.
      instance_type: {{instance_type}}
      disk_size: {{disk_size}}
      cpus: {{cpus}}
      memory: {{memory}}
      accelerator_type: {{accelerator_type}}
      accelerator_count: {{accelerator_count}}
      gpu_resource: {{gpu_resource}}
{% if gpu_type_resource is not none %}
      gpu_type_resource: {{gpu_type_resource}}
{% endif %}
{% if qsub_options is defined and qsub_options %}
      qsub_options: {{qsub_options | tojson}}
{% endif %}
{% if select_resources is defined and select_resources %}
      select_resources: {{select_resources | tojson}}
{% endif %}
{% if place is not none %}
      place: {{place | tojson}}
{% endif %}

head_node_type: ray_head_default

# Format: `REMOTE_PATH : LOCAL_PATH`
file_mounts: {
  "{{sky_ray_yaml_remote_path}}": "{{sky_ray_yaml_local_path}}",
  "{{sky_remote_path}}/{{sky_wheel_hash}}": "{{sky_local_path}}",
{%- for remote_path, local_path in credentials.items() %}
  "{{remote_path}}": "{{local_path}}",
{%- endfor %}
}

rsync_exclude: []

initialization_commands: []

# List of shell commands to run to set up nodes.
# NOTE: these are very performance-sensitive. Each new item opens/closes an SSH
# connection, which is expensive. Try your best to co-locate commands into fewer
# items!
#
# Increment the following for catching performance bugs easier:
#   current num items (num SSH connections): 1
setup_commands:
  - |
    {%- for initial_setup_command in initial_setup_commands %}
    {{ initial_setup_command }}
    {%- endfor %}
    # Interactive `ssh <cluster>` sessions land in the real home; move them
    # into the cluster's shared home like every SkyPilot command.
    cat > ~{{ssh_user}}/.sky_ssh_rc <<'SKYPILOT_SSH_RC'
    # Added by SkyPilot: override HOME for PBS interactive sessions
    if [ -n "${{pbs_cluster_name_env_var}}" ]; then
        CLUSTER_DIR={{sky_base_dir}}/.sky_clusters/${{pbs_cluster_name_env_var}}
        if [ -d "$CLUSTER_DIR" ]; then
            cd "$CLUSTER_DIR"
            export HOME=$(pwd)
        fi
    fi
    SKYPILOT_SSH_RC
    grep -q "source ~/.sky_ssh_rc" ~{{ssh_user}}/.bashrc 2>/dev/null || (echo "" >> ~{{ssh_user}}/.bashrc && echo "source ~/.sky_ssh_rc" >> ~{{ssh_user}}/.bashrc)
    {{ setup_sky_dirs_commands }}
    {{ conda_installation_commands }}
    {{ uv_installation_commands }}
    {{ skypilot_wheel_installation_commands }}
    {{ copy_skypilot_templates_commands }}

head_node: {}
worker_nodes: {}

# These fields are required for external cloud providers.
head_setup_commands: []
worker_setup_commands: []
cluster_synced_files: []
file_mounts_sync_continuously: False
